{
  "realm": "drill",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "mailbox-user",
        "description": "May hold owner or delegate grants on a mailbox"
      },
      {
        "name": "mailbox-manager",
        "description": "May hold manager_view grants on a mailbox"
      }
    ]
  },
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Drill",
      "credentials": [
        {
          "type": "password",
          "value": "drill-not-a-real-password-alice",
          "temporary": false
        }
      ],
      "realmRoles": [
        "mailbox-user"
      ],
      "email": "alice@drill.internal"
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Drill",
      "credentials": [
        {
          "type": "password",
          "value": "drill-not-a-real-password-bob",
          "temporary": false
        }
      ],
      "realmRoles": [
        "mailbox-user"
      ],
      "email": "bob@drill.internal"
    },
    {
      "id": "33333333-3333-4333-8333-333333333333",
      "username": "mia",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Mia",
      "lastName": "Drill",
      "credentials": [
        {
          "type": "password",
          "value": "drill-not-a-real-password-mia",
          "temporary": false
        }
      ],
      "realmRoles": [
        "mailbox-manager"
      ],
      "email": "mia@drill.internal"
    }
  ],
  "clients": [
    {
      "clientId": "drill-app",
      "name": "Drill relying party",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://app.drill.internal:8000/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://app.drill.internal:8000/"
      },
      "protocolMappers": [
        {
          "name": "realm roles in id token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 90,
      "config": {}
    }
  ]
}
